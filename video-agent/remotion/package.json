{
  "name": "dev-day-video",
  "version": "1.0.0",
  "private": true,
  "description": "Render an editable SVG storyboard into an MP4 with Remotion. Edit public/day.svg and re-render to change the video.",
  "scripts": {
    "render": "remotion render src/index.ts StoryVideo out/story.mp4 --bundle-cache=false",
    "studio": "remotion studio src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}